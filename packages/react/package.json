{
  "name": "dsh-harmony-react",
  "version": "0.3.2",
  "description": "React-aware source patch factories for dsh-harmony",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "harmony",
    "react",
    "runtime-patching",
    "typescript-ast"
  ],
  "homepage": "https://github.com/memorax-ai/dsh-harmony/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/memorax-ai/dsh-harmony/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorax-ai/dsh-harmony.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": {
    "name": "CH4ACKO3",
    "url": "https://github.com/CH4ACKO3"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./studio": {
      "types": "./lib/studio.d.ts",
      "default": "./lib/studio.js"
    },
    "./studio-host": {
      "types": "./lib/studio-host.d.ts",
      "default": "./lib/studio-host.js"
    }
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p examples/rebrand-plugin/tsconfig.json && tsc -p examples/rebrand-plugin/tsconfig.client.json",
    "check": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.15.0 || >=23.5.0"
  },
  "peerDependencies": {
    "dsh-harmony": "^0.8.0"
  },
  "devDependencies": {
    "@phenomnomnominal/tsquery": "^6.2.0",
    "@types/node": "^24.10.0",
    "dsh-harmony": "file:../..",
    "magic-string": "^0.30.21",
    "typescript": "^6.0.3"
  }
}
